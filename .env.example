# Configure these in Vercel Project Settings > Environment Variables.
# external is Hobby-compatible; vercel-cron requires Pro or Enterprise.
AGENT_WORKER_SCHEDULER=external
# Neon native integration injects a pooled DATABASE_URL; retain its SSL settings.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
APP_API_TOKEN=
CRON_SECRET=
APP_USER_ID=
APP_TENANT_ID=

# All built-in providers in the installed Pi catalog are registered.
# Select one provider/model; Pi resolves that provider's credentials from env.
AGENT_PROVIDER=deepseek
AGENT_MODEL_ID=deepseek-flash
DEEPSEEK_API_KEY=

# Configure only the credentials needed by your selected provider.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# AI_GATEWAY_API_KEY=
# See docs/function-runtime.md for provider and auth boundaries.

# Leave 15s between drive/invocation and invocation/the 300-second Function limit.
AGENT_PASS_MS=270000
AGENT_INVOCATION_MS=285000
# API admission ownership budget; increase only after measuring database latency.
AGENT_ADMISSION_MS=10000

# Optional deterministic local smoke mode; omit for real provider execution.
# AGENT_FAUX_RESPONSE=durable local response

# Application entries initialize @vercel/otel on Vercel; configure Trace Drains separately.
# SQL summaries are always retained; per-operation spans are opt-in.
# AGENT_TRACE_SQL_DETAIL=true
# Local tracing is off unless an OTLP collector endpoint is explicitly configured.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# OTEL_SDK_DISABLED=true

# Optional local worker:external target; deployed Functions do not use this.
# EXTERNAL_WORKER_URL=https://YOUR-DEPLOYMENT.vercel.app
