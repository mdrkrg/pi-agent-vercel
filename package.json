{
  "name": "pi-agent-vercel-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "24.x"
  },
  "description": "Durable agent runtime proof of concept",
  "scripts": {
    "check": "tsc --noEmit && pnpm --filter @pi-agent/chat check",
    "build": "pnpm check && pnpm --filter @pi-agent/chat build",
    "dev:faux": "tsx scripts/dev.ts start",
    "dev:stop": "tsx scripts/dev.ts stop",
    "dev:reset": "tsx scripts/dev.ts reset",
    "dev:ui": "pnpm --filter @pi-agent/chat dev",
    "docs:check": "tsx scripts/check-doc-links.ts",
    "dev:service": "tsx scripts/local-service.ts",
    "worker:once": "tsx scripts/function-worker.ts",
    "worker:external": "tsx scripts/worker-external.ts",
    "test": "vitest run --config vitest.config.ts && pnpm --filter @pi-agent/chat test"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pg": "8.15.5",
    "concurrently": "10.0.5",
    "marked": "18.0.14",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.9"
  }
}
